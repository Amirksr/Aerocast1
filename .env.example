# ─────────────────────────────────────────────────────────────
# Aero Weather — environment variables
# Copy this file to `.env.local` and fill in your values.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string. Provide your own Atlas URI to persist
# favorites, search history, contact messages and newsletter signups.
# If left empty the API automatically falls back to an in-memory store,
# so the app still works for local demos without a database.
MONGODB_URI=""

# Optional: database name (defaults to "aero_weather")
MONGODB_DB="aero_weather"

# Public site URL (used for metadata / open graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
